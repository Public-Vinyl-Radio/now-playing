# Optional port for Caddy running on the host.
PVR_PORT=3010

# Only needed with deploy/compose.caddy.yaml for Caddy in Docker.
CADDY_NETWORK=proxy

# Choose mock for visual development or homeassistant for the live broadcast.
PVR_DATA_MODE=mock
HA_BASE_URL=https://ha.home.arpa
HA_MEDIA_PLAYER_ENTITY_ID=media_player.living_room_audio
HA_VINYL_SENSOR_ENTITY_ID=binary_sensor.vinyl_listening_active
# Resolve through op run; the token is only supplied to the running server.
HA_TOKEN=op://Homelab/Home Assistant Codex Token/token
# Optional comma-separated HTTPS origins for external cover art. HA itself is allowed.
HA_ARTWORK_ORIGINS=
HA_RECONNECT_BASE_MS=1000
HA_RECONNECT_MAX_MS=30000

# Optional public CA certificate path for deploy/compose.ca.yaml.
# CADDY_ROOT_CERT=/path/to/caddy/root.crt
