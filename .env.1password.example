# Copy to .env.1password; this file contains a reference, not a resolved secret.
PVR_DATA_MODE=homeassistant
HA_BASE_URL=https://ha.home.arpa
HA_MEDIA_PLAYER_ENTITY_ID=media_player.living_room_audio
HA_VINYL_SENSOR_ENTITY_ID=binary_sensor.vinyl_listening_active
HA_TOKEN=op://Homelab/Home Assistant Codex Token/token
# Trust the local CA already installed in this Mac's system certificate store.
NODE_OPTIONS=--use-system-ca
